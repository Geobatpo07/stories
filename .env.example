# Stories Platform — environment variables
# Copy to .env.local and fill in real values for local development.
# Never commit .env.local — see .gitignore.

# DuckDB analytical index (generated, not the source of truth — see ADR-001)
DUCKDB_PATH=./database/generated/knowledge.duckdb

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private local authoring workspace. Leave disabled on public deployments.
STORIES_STUDIO_ENABLED=false

# Studio authentication — password-reset email, sent via Resend's HTTP API
# (see runtime/adapters/resend-email-adapter.ts). Create a Resend account and
# API key at https://resend.com; STUDIO_ADMIN_RESET_FROM_EMAIL must be either
# a verified sending domain or Resend's onboarding@resend.dev test address.
RESEND_API_KEY=resend_api_key_here
STUDIO_ADMIN_RESET_FROM_EMAIL=onboarding@resend.dev

# Supabase — backs Studio drafts and Studio authentication (credentials,
# sessions, reset tokens); see runtime/adapters/supabase-persistence-adapter.ts
# and supabase/migrations/0001_persistence_records.sql (run that migration in
# your project's SQL Editor before setting these). SUPABASE_SERVICE_ROLE_KEY
# must be the service_role key, not the anon/public key: this adapter is
# server-only and needs to bypass Row Level Security, not operate under it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Studio publishing through the Python API (backend/publication). The API commits the rendered MDX
# to GitHub (one atomic commit, after the content tree passes the build); Vercel then deploys it.
# GITHUB_PUBLISH_TOKEN: a fine-grained personal access token limited to THIS repository only, with
# the repository permission "Contents: Read and write" (Metadata: read is implicit). It must be
# created and stored by a person; nothing in this repo creates it. If the branch is protected the
# token's owner must be allowed to push to it. GITHUB_REPOSITORY is "owner/name".
GITHUB_PUBLISH_TOKEN=github_pat_replace_me
GITHUB_REPOSITORY=owner/stories
GITHUB_PUBLISH_BRANCH=main

# Shared secret for app/api/internal/revalidate (called by the Python API after a publication).
# Set the SAME random value on the Next.js app and on the Python service, e.g. `openssl rand -hex 32`.
REVALIDATE_SECRET=replace_with_a_long_random_value

# Studio frontend -> Python API (ADR-004 phase 4). There is no platform routing yet (phase 6), so the
# Next.js app calls the Python service directly. Local: `uv run uvicorn main:app --port 8000` from
# backend/. PYTHON_API_BASE_URL is read by Server Components (pages), NEXT_PUBLIC_PYTHON_API_BASE_URL
# is inlined into the browser bundle for the editor's save/publish calls; leave the latter unset for
# same-origin. STUDIO_ALLOWED_ORIGINS is read by the Python service: the browser origins allowed to
# call it with the session cookie (comma-separated, never "*").
PYTHON_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PYTHON_API_BASE_URL=http://127.0.0.1:8000
STUDIO_ALLOWED_ORIGINS=http://localhost:3000
