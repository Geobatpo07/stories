# Stories Platform — environment variables
# Copy to .env.local and fill in real values for local development.
# Never commit .env.local — see .gitignore.

# DuckDB analytical index (generated, not the source of truth — see ADR-001)
DUCKDB_PATH=./database/generated/knowledge.duckdb

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private local authoring workspace. Leave disabled on public deployments.
STORIES_STUDIO_ENABLED=false

# Studio authentication — password-reset email, sent via Resend's HTTP API
# (see runtime/adapters/resend-email-adapter.ts). Create a Resend account and
# API key at https://resend.com; STUDIO_ADMIN_RESET_FROM_EMAIL must be either
# a verified sending domain or Resend's onboarding@resend.dev test address.
RESEND_API_KEY=resend_api_key_here
STUDIO_ADMIN_RESET_FROM_EMAIL=onboarding@resend.dev

# Supabase — backs Studio drafts and Studio authentication (credentials,
# sessions, reset tokens); see runtime/adapters/supabase-persistence-adapter.ts
# and supabase/migrations/0001_persistence_records.sql (run that migration in
# your project's SQL Editor before setting these). SUPABASE_SERVICE_ROLE_KEY
# must be the service_role key, not the anon/public key: this adapter is
# server-only and needs to bypass Row Level Security, not operate under it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Studio publishing through the Python API (backend/publication). The API commits the rendered MDX
# to GitHub (one atomic commit, after the content tree passes the build); Vercel then deploys it.
# GITHUB_PUBLISH_TOKEN: a fine-grained personal access token limited to THIS repository only, with
# the repository permission "Contents: Read and write" (Metadata: read is implicit). It must be
# created and stored by a person; nothing in this repo creates it. If the branch is protected the
# token's owner must be allowed to push to it. GITHUB_REPOSITORY is "owner/name".
GITHUB_PUBLISH_TOKEN=github_pat_replace_me
GITHUB_REPOSITORY=owner/stories
GITHUB_PUBLISH_BRANCH=main

# Shared secret for app/api/internal/revalidate (called by the Python API after a publication).
# Set the SAME random value on the Next.js app and on the Python service, e.g. `openssl rand -hex 32`.
REVALIDATE_SECRET=replace_with_a_long_random_value

# Studio frontend -> Python API.
#
# LOCAL DEV (two separate processes, two separate origins — see
# docs/operations/DEVELOPER-WORKFLOW.md): the Next.js app calls the Python service
# directly over HTTP, and the browser calls it cross-origin, so all three variables below
# are required locally. PYTHON_API_BASE_URL is read by Server Components (pages);
# NEXT_PUBLIC_PYTHON_API_BASE_URL is inlined into the browser bundle for the editor's
# save/publish calls, which then go straight to Python, cross-origin — this only works
# locally because STUDIO_ALLOWED_ORIGINS below opens CORS for it. Keep both in sync with
# whatever port `pnpm dev` actually prints (Next falls back to 3001, 3002, ... when 3000
# is taken).
PYTHON_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PYTHON_API_BASE_URL=http://127.0.0.1:8000
STUDIO_ALLOWED_ORIGINS=http://localhost:3000
#
# PRODUCTION, Python hosted anywhere else (Render, Fly.io, a VPS — recommended, needs no
# platform feature): leave NEXT_PUBLIC_PYTHON_API_BASE_URL and STUDIO_ALLOWED_ORIGINS
# completely UNSET. With the client base URL unset, the editor's save/publish calls
# (lib/studio-client.ts) fall back to same-origin relative paths, which land on the
# already-built Next.js relay routes (app/api/studio/**/route.ts, app/api/auth/*/route.ts
# — see lib/python-api.ts's pythonApiRelay) instead of calling Python directly. Those
# routes forward the session cookie themselves, server-to-server, which is never subject
# to the browser's cross-origin cookie rules — so Python can live on a completely
# different domain with no CORS and no shared-cookie-domain setup needed at all.
# PYTHON_API_BASE_URL (server-only) is simply that other host's URL, e.g.
# https://stories-api.onrender.com. On a non-Vercel host, also set STORIES_ENV=production
# explicitly (backend/api/settings.py otherwise only infers production from Vercel's own
# VERCEL=1, which a different host never sets) — this controls the session cookie's
# Secure flag and the login rate limiter's fail-closed behavior.
#
# PRODUCTION, Vercel Services (ADR-004 phase 6, see vercel.json and DEPLOYMENT.md): an
# alternative if Next.js and the Python API ever deploy as two services of the SAME
# Vercel project instead — genuinely same-origin via a platform-level rewrite, rather than
# same-origin-via-relay as above. Not required for the Studio to work correctly; only
# worth it if/when consolidating onto one Vercel project matters for its own sake. Still a
# Beta Vercel feature as of this writing.
