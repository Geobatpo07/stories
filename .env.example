# Stories Platform — environment variables
# Copy to .env.local and fill in real values for local development.
# Never commit .env.local — see .gitignore.

# DuckDB analytical index (generated, not the source of truth — see ADR-001)
DUCKDB_PATH=./database/generated/knowledge.duckdb

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private local authoring workspace. Leave disabled on public deployments.
STORIES_STUDIO_ENABLED=false

# Studio authentication — password-reset email, sent via Resend's HTTP API
# (see runtime/adapters/resend-email-adapter.ts). Create a Resend account and
# API key at https://resend.com; STUDIO_ADMIN_RESET_FROM_EMAIL must be either
# a verified sending domain or Resend's onboarding@resend.dev test address.
RESEND_API_KEY=resend_api_key_here
STUDIO_ADMIN_RESET_FROM_EMAIL=onboarding@resend.dev

# Supabase — backs Studio drafts and Studio authentication (credentials,
# sessions, reset tokens); see runtime/adapters/supabase-persistence-adapter.ts
# and supabase/migrations/0001_persistence_records.sql (run that migration in
# your project's SQL Editor before setting these). SUPABASE_SERVICE_ROLE_KEY
# must be the service_role key, not the anon/public key: this adapter is
# server-only and needs to bypass Row Level Security, not operate under it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
